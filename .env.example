# Variables opcionales (Vite). Copiar a `.env.local` solo para desarrollo.
#
# IMPORTANTE: en producción (Vercel) estas variables deben estar SIN DEFINIR.
# Si no están definidas, la app usa los hosts de producción actuales de cada endpoint.

# Backend principal (login, /health, /api/calculos-medidor)
# VITE_API_URL=http://localhost:3000

# Backend de vouchers (/api/vouchers y las imágenes subidas)
# VITE_VOUCHERS_API_URL=http://localhost:3000
