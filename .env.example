# Variable opcional (Vite). Copiar a `.env.local` solo para desarrollo.
#
# Hay un solo backend (Vercel): https://hostal-mayelewoo-backend.vercel.app
# Si VITE_API_URL no está definida, la app usa ese host (y http://localhost:3000
# cuando la página corre en localhost / 127.0.0.1).
#
# IMPORTANTE: NO definir VITE_API_URL en Netlify/producción. Vite la incrusta en el
# bundle durante el build; un .env local apuntando a localhost es solo para desarrollo.
#
# Backend para TODAS las peticiones (login, /health, /api/calculos-medidor, /api/vouchers, imágenes)
# VITE_API_URL=http://localhost:3000
